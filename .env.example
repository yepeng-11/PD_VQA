# Export these variables in the process; CLI does not silently load .env files.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set a model ID supported by your account; no hard-coded current model assumption.
DEEPSEEK_MODEL=

# Optional independent gait/face/speech multimodal expert backend.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-omni-flash
